+export const emerge = (
+  value: number,
+  from: number,
+  to: number,
+  ramp = 0.3,
+  hold = 0.6,
+): number => {
+  const t = range(value, from, to);
+  const up = ramp > 0 ? t / ramp : 1;
+  const down = hold < 1 ? (t - hold) / (1 - hold) : t;
+  return Math.min(easeOutCubic(up), 1 - easeOutCubic(down));
+};
