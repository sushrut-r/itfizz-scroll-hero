{
  "name": "itfizz-scroll-hero",
  "version": "1.0.0",
  "private": true,
  "description": "Scroll-driven hero section: sticky pinned track, car that drives with scroll progress, letter-by-letter headline reveal and staggered impact metrics. Next.js + React + Tailwind + GSAP.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "preview": "python3 scripts/preview-server.py 4100",
    "deploy:gh": "node scripts/build-pages.mjs",
    "assets": "python3 tools/process-car.py",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"{app,components,lib,scripts}/**/*.{ts,tsx,css,json}\" \"*.{ts,mjs,json}\"",
    "format:check": "prettier --check \"{app,components,lib,scripts}/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "gsap": "3.15.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "prettier": "3.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
